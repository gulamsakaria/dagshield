# Copy this file to .env by running:  python scripts/gen_demo_key.py
# .env is ignored by Git. NEVER commit it, and never paste real keys into this example file.

# Ed25519 demo signing key (base64, 32 bytes). Generated for you by the script.
DAGSHIELD_SIGNING_KEY=
# Database password used by docker-compose (generated for you by the script).
POSTGRES_PASSWORD=

# Optional: if set, resetting scenarios and changing alert status needs the header X-Admin-Token.
DAGSHIELD_ADMIN_TOKEN=

# Demo login for the synthetic officer portal. Defaults exist for a local demo; change both for anything shared.
DAGSHIELD_OFFICER_USER=
DAGSHIELD_OFFICER_PASSWORD=

# Optional: set to true to show a one-click "Judge demo" (no password, sample data). For demo or judging servers only.
DAGSHIELD_JUDGE_LOGIN=false

# Optional: folder with the built web UI. When set, the API serves the site itself (single-domain hosting, e.g. cPanel).
DAGSHIELD_STATIC_DIR=

# Where the QR code sends people (the web UI address) and which origins may call the API.
DAGSHIELD_PUBLIC_BASE_URL=http://localhost:8080
DAGSHIELD_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

DAGSHIELD_RATE_LIMIT_PER_MIN=120
DAGSHIELD_ENABLE_DOCS=true

# Rule parameters (areas are in decimal)
DAGSHIELD_AREA_TOLERANCE=0
DAGSHIELD_LINEAGE_CONFIDENCE_MIN=0.8
DAGSHIELD_ENABLE_R5=true
DAGSHIELD_R5_WINDOW_DAYS=30
DAGSHIELD_R5_MIN_EVENTS=3
